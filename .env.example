# Backend (Render) — Render injects DATABASE_URL automatically for the Blueprint
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string

# Comma/semicolon — the ONLY people allowed to log in and manage the project.
# Open registration is disabled, so these accounts are how staff get access.
# Format: JSON array. Passwords are hashed; 2FA is set up on first sign-in.
# Set this on Render (Environment) to your 4 team members.
ADMIN_USERS=[{"username":"alice","email":"alice@example.com","password":"change-me-1"},{"username":"bob","email":"bob@example.com","password":"change-me-2"},{"username":"carol","email":"carol@example.com","password":"change-me-3"},{"username":"dave","email":"dave@example.com","password":"change-me-4"}]