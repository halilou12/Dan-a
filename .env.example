# Environment variables for the Netlify deployment. Set these in the Netlify
# UI under Site settings -> Environment variables (and in a local .env for
# `npm run dev`).

# Postgres connection string (e.g. Neon). Keep ?sslmode=require.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Long random string. Must stay constant, otherwise all admin sessions are
# invalidated on every cold start.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: seed admin accounts on startup. JSON array of
# {username, email, password}. Each account needs a password of 8+ characters.
# The TOTP secret for step-2 sign-in is printed to the function logs.
# ADMIN_USERS=[{"username":"admin","email":"you@example.com","password":"changeme123"}]

# Public URL of the deployed frontend (Netlify), used to build password-reset
# links in emails.
APP_URL=https://kigali-barista.app

# SMTP for sending password-reset emails (e.g. Gmail, Zoho, Outlook).
# If these are not set, the app falls back to returning the reset token in the
# response (local development only) instead of emailing it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional sender "From" address override.
# SMTP_FROM="KSB Admin <no-reply@yourdomain.com>"
# Public URL used to build the clickable reset link in the email.
# Overrides APP_URL when set; set it locally if needed.
# SMTP_APP_URL=http://localhost:5173
